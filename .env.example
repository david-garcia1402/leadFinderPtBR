HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
OUTSCRAPER_API_KEY=
ENABLE_LIVE_SEARCH=false
ENABLE_SAMPLE_DATA=false
MAX_MONTHLY_RECORDS=100

# SEO: HTTPS origins without paths. Leave blank on local/staging deployments.
# PUBLIC_SITE_URL is this deployment; use the same language pair in both deployments.
PUBLIC_SITE_URL=
EN_SITE_URL=
PT_BR_SITE_URL=

# Contas e cobrança (somente esta versão pt-BR).
# DATA_DIR=./.data
# Provedor: kiwify | mercadopago | hosted
BILLING_PROVIDER=kiwify
# BILLING_PROVIDER_LABEL=Kiwify

# Kiwify: um produto/oferta por plano + token do webhook em Apps → Webhooks.
# KIWIFY_WEBHOOK_TOKEN=
# KIWIFY_CHECKOUT_ESSENCIAL=https://pay.kiwify.com.br/...
# KIWIFY_CHECKOUT_PROFISSIONAL=
# KIWIFY_CHECKOUT_ESCALA=
# KIWIFY_PRODUCT_ESSENCIAL=
# KIWIFY_PRODUCT_PROFISSIONAL=
# KIWIFY_PRODUCT_ESCALA=

# Checkout hospedado genérico (Hotmart, Eduzz, Stripe Payment Link, etc.).
# BILLING_PROVIDER=hosted
# BILLING_WEBHOOK_SECRET=
# CHECKOUT_URL_ESSENCIAL=
# CHECKOUT_URL_PROFISSIONAL=
# CHECKOUT_URL_ESCALA=
# BILLING_PRODUCT_ESSENCIAL=
# BILLING_PRODUCT_PROFISSIONAL=
# BILLING_PRODUCT_ESCALA=

# Mercado Pago (opcional). APP_ORIGIN precisa ser HTTPS público para criar a pré-aprovação.
# BILLING_PROVIDER=mercadopago
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
