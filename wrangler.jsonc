{
  "name": "leadfinder-pt-br",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadfinder-db",
      "database_id": "cd357632-4a62-4578-a299-c975879d9591"
    }
  ]
}
